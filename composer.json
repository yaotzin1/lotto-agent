{
  "name": "hazardzista/lotto-simulator",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-gmp": "*",
    "symfony/framework-bundle": "^7.0",
    "symfony/runtime": "^7.0",
    "symfony/console": "^7.0",
    "symfony/yaml": "^7.0",
    "symfony/twig-bundle": "^7.0",
    "symfony/webpack-encore-bundle": "^4.0"
  },
  "require-dev": {
    "symfony/var-dumper": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php bin/console cache:clear --no-warmup || true"
    ],
    "post-update-cmd": [
      "@php bin/console cache:clear --no-warmup || true"
    ]
  }
}
