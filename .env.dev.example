
###> symfony/framework-bundle ###
APP_SECRET=
###< symfony/framework-bundle ###
GEMINI_API_KEY=
LOTTO_API_KEY=

# ==============================================================================
# Multi-Provider AI Configuration (Defaults to Google Gemini)
# ==============================================================================
# Supported AI_PROVIDER values: gemini, claude, openai, deepseek
AI_PROVIDER=gemini

# Specific model override (optional; leave blank to use the provider's recommended default):
#   * Gemini:   gemini-3.7-flash (default), gemini-2.5-pro (analytical), gemini-3.8-flash, gemini-2.5-flash
#   * Claude:   claude-3-7-sonnet-20250219 (default), claude-3-opus-20240229 (deep stats), claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
#   * OpenAI:   gpt-4o (default), o3-mini (reasoning), gpt-4o-mini (budget), gpt-4-turbo
#   * DeepSeek: deepseek-chat (default / DeepSeek-V3), deepseek-reasoner (DeepSeek-R1 math logic)
AI_MODEL=

# API Keys (fill the one matching your selected AI_PROVIDER):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=

