{% extends 'base.html.twig' %}

{% block title %}Mini-Lotto Simulator{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="card-title h5 mb-0">Select Your Numbers</h2>
                </div>
                <div class="card-body">
                    {% if error %}
                        <div class="alert alert-danger">{{ error }}</div>
                    {% endif %}
                    
                    <form method="post" action="{{ path('mini_lotto') }}">
                        <div class="mb-4">
                            <label class="form-label">Choose 6-12 numbers:</label>
                            <div class="number-grid">
                                {% for i in 1..39 %}
                                    <div>
                                        <input type="checkbox" class="number-checkbox" id="number-{{ i }}" 
                                               name="numbers[]" value="{{ i }}" 
                                               {% if i in selectedNumbers %}checked{% endif %}>
                                        <label class="number-label" for="number-{{ i }}">{{ i }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label for="drawCount" class="form-label">Number of past draws to analyze (50-500):</label>
                            <input type="range" class="form-range" id="drawCount" name="drawCount" 
                                   min="50" max="500" step="10" value="{{ drawCount }}"
                                   oninput="drawCountValue.value = this.value">
                            <output id="drawCountValue">{{ drawCount }}</output>
                        </div>
                        
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Analyze Combinations</button>
                        </div>
                    </form>
                </div>
            </div>
            
            {% if results %}
                <div class="card mt-4">
                    <div class="card-header bg-success text-white">
                        <h2 class="card-title h5 mb-0">Analysis Results</h2>
                    </div>
                    <div class="card-body">
                        <p>
                            You selected {{ selectedNumbers|length }} numbers: 
                            <strong>{{ selectedNumbers|sort|join(', ') }}</strong>
                        </p>
                        <p>
                            Total combinations analyzed: <strong>{{ results.totalCombinations }}</strong>
                        </p>
                        
                        <div class="table-responsive">
                            <table class="table table-striped results-table">
                                <thead>
                                    <tr>
                                        <th>Hit Type</th>
                                        <th>Count</th>
                                        <th>Percentage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>3 out of 5 hits</td>
                                        <td>{{ results['3'] }}</td>
                                        <td>
                                            {% if results.totalCombinations > 0 %}
                                                {{ (results['3'] / (results.totalCombinations * drawCount) * 100)|round(2) }}%
                                            {% else %}
                                                0%
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>4 out of 5 hits</td>
                                        <td>{{ results['4'] }}</td>
                                        <td>
                                            {% if results.totalCombinations > 0 %}
                                                {{ (results['4'] / (results.totalCombinations * drawCount) * 100)|round(2) }}%
                                            {% else %}
                                                0%
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>5 out of 5 hits (Jackpot)</td>
                                        <td>{{ results['5'] }}</td>
                                        <td>
                                            {% if results.totalCombinations > 0 %}
                                                {{ (results['5'] / (results.totalCombinations * drawCount) * 100)|round(2) }}%
                                            {% else %}
                                                0%
                                            {% endif %}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="alert alert-info mt-3">
                            <p class="mb-0">
                                <strong>Summary:</strong> Based on the last {{ drawCount }} draws, your selected numbers 
                                would have resulted in {{ results['3'] + results['4'] + results['5'] }} winning combinations
                                ({{ results['3'] }} with 3/5 hits, {{ results['4'] }} with 4/5 hits, and {{ results['5'] }} with 5/5 hits).
                            </p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Count selected numbers and show warning if outside 6-12 range
        const checkboxes = document.querySelectorAll('.number-checkbox');
        const form = document.querySelector('form');
        
        form.addEventListener('submit', function(e) {
            const checked = document.querySelectorAll('.number-checkbox:checked');
            if (checked.length < 6 || checked.length > 12) {
                e.preventDefault();
                alert('Please select between 6 and 12 numbers.');
            }
        });
    });
</script>
{% endblock %}