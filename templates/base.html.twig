<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Mini-Lotto Simulator{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body {
                background-color: #f8f9fa;
                padding-top: 20px;
            }
            .number-grid {
                display: grid;
                grid-template-columns: repeat(5, 1fr);
                gap: 10px;
            }
            @media (min-width: 768px) {
                .number-grid {
                    grid-template-columns: repeat(8, 1fr);
                }
            }
            .number-checkbox {
                display: none;
            }
            .number-label {
                display: flex;
                justify-content: center;
                align-items: center;
                width: 100%;
                height: 40px;
                border-radius: 50%;
                background-color: #e9ecef;
                cursor: pointer;
                transition: all 0.2s;
            }
            .number-checkbox:checked + .number-label {
                background-color: #0d6efd;
                color: white;
            }
            .results-table {
                width: 100%;
                margin-top: 20px;
            }
            .card {
                margin-bottom: 20px;
                box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="container">
            <header class="mb-4">
                <h1 class="text-center">Mini-Lotto Simulator</h1>
                <p class="text-center text-muted">Analyze your number combinations against historical draws</p>
            </header>

            <main>
                {% block body %}{% endblock %}
            </main>

            <footer class="mt-5 text-center text-muted">
                <p>&copy; {{ "now"|date("Y") }} Mini-Lotto Simulator</p>
            </footer>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>